# spotify-taste 설정 예시.
# 이 파일을 `.env` 로 복사한 뒤 값을 채운다. `.env` 는 gitignore 되어 있다.
# 값을 비워 두면 아래 주석의 기본값이 쓰인다.

# ---------------------------------------------------------------------------
# Spotify (PKCE — client secret 을 쓰지 않는다. 의도된 설계)
# ---------------------------------------------------------------------------
# developer.spotify.com/dashboard 에서 앱을 만들고 받은 Client ID.
# 대시보드에 Client Secret 도 보이지만 여기 넣지 말 것 — PKCE 는 시크릿이
# 필요 없고, "혹시 몰라서" 적어 두는 것이 로그 유출의 시작이다.
SPOTIFY_CLIENT_ID=

# 대시보드에 등록한 값과 **문자 그대로** 일치해야 한다.
# localhost 는 거부된다 (명시적 루프백 IP 만 http 허용). 포트 와일드카드 없음.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# 토큰 번들 저장 위치. 비우면 메모리 전용(개발용) — 프로세스가 죽으면 재인증.
SPOTIFY_TOKEN_PATH=data/auth/spotify-token.json

# ---------------------------------------------------------------------------
# 저장소
# ---------------------------------------------------------------------------
DB_PATH=data/spotify-taste.db

# 비우면 백업 비활성.
BACKUP_DIR=data/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=8

# /me/player 원본 응답을 N 틱마다 1회 통째로 보관 (필드 삭제 감지용 카나리).
# 세션 첫 샘플과 "처음 보는 응답 모양"은 이 값과 무관하게 항상 보관된다.
RAW_PLAYER_SAMPLE_EVERY=20

# ---------------------------------------------------------------------------
# 폴러 튜닝
# ---------------------------------------------------------------------------
PLAYER_POLL_SEC=25

# 연속 유휴(204) 시 늘려 갈 간격(초). 마지막 값이 상한.
# 300초까지 늘리면 청취를 재개했을 때 최대 5분을 ms_played 가 없는
# recently-played 경로에 넘기게 된다 — 그래서 120초에서 멈춘다.
PLAYER_IDLE_BACKOFF_SEC=25,45,90,120

RECENT_POLL_SEC=600

# 백필은 복수 조회 엔드포인트가 사라져 1엔티티=1콜이다. 야간에 예산제로 흘린다.
BACKFILL_MIN_INTERVAL_SEC=0.5
BACKFILL_MAX_CALLS_PER_RUN=3000

# 이보다 긴 Retry-After 를 받으면 자지 않고 배치를 중단한다.
MAX_RETRY_AFTER_SEC=300

# ---------------------------------------------------------------------------
# 분류
# ---------------------------------------------------------------------------
# context 가 항상 null 로 오는 계정을 위한 성능저하 모드.
# `classify report` 의 null-context 비율이 80% 를 넘으면 켤 것을 검토한다.
# 이 값은 RULES_VERSION 의 일부라, 뒤집으면 전 행이 재분류 대상이 된다.
CONTEXT_NULL_ACCOUNT=false

# ---------------------------------------------------------------------------
# 운영
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
HEARTBEAT_PATH=data/heartbeat/collector.txt
ALERT_DIR=data/alerts

# @BotFather 로 만든 신규 봇 (auto-trade 봇과 분리할 것).
# 비워 두면 알림이 NoopNotifier 로 떨어져 조용히 아무것도 보내지 않는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
